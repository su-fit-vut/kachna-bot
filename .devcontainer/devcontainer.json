{
  "name": "KachnaBot",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "kachnabot",
  "workspaceFolder": "/app",
  "remoteUser": "app",
  "postCreateCommand": "uv sync --locked --all-groups && uv run pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "GitHub.vscode-github-actions"
      ]
    }
  }
}
